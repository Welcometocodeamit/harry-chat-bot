# ============================================================
# Harry Chat Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# OpenRouter API (LLM + Embeddings)
# ----------------------------------------------------------
# Get your API key from https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter base URL (do not change unless self-hosting)
OPEN_API_BASE=https://openrouter.ai/api/v1

# Embedding model — used to vectorize documents & queries
# Recommended: openai/text-embedding-3-small (cheap & accurate)
EMBEDDING_MODEL=openai/text-embedding-3-small

# ----------------------------------------------------------
# LLM Configuration
# ----------------------------------------------------------
# Model ID from https://openrouter.ai/models
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# ----------------------------------------------------------
# Qdrant Vector Database
# ----------------------------------------------------------
# For local development with Docker:
#   QDRANT_CLIENT_URL=http://localhost:6333
#   QDRANT_API_KEY=            (leave empty for local)
#
# For Qdrant Cloud (https://cloud.qdrant.io):
QDRANT_CLIENT_URL=http://localhost:6333
QDRANT_API_KEY=

# ----------------------------------------------------------
# Search Configuration
# ----------------------------------------------------------
# Number of top-K similar chunks to retrieve
SEARCH_K=15

# Search strategy: "similarity" | "mmr" (maximal marginal relevance)
SEARCH_TYPE=similarity
